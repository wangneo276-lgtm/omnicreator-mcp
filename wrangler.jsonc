{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omnicreator-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "5ff96a3903622fc3f23ded9cff417af4",
  "workers_dev": true,
  "routes": [
    { "pattern": "omnicreator.art/mcp", "zone_name": "omnicreator.art" },
    { "pattern": "omnicreator.art/mcp/*", "zone_name": "omnicreator.art" }
  ],
  "observability": {
    "enabled": true
  }
}
